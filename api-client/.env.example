# Synthetic local-only accounts. Never use these passwords outside development.
CUSTOMER_EMAIL=developer@example.test
CUSTOMER_PASSWORD="Facets local rivers orbit quietly 2026"
CUSTOMER_NEW_PASSWORD="Facets local mountains drift softly 2026"
STAFF_EMAIL=staff@example.test
STAFF_PASSWORD="Facets staff lanterns shine quietly 2026"
STAFF_NEW_PASSWORD="Facets staff forests breathe softly 2026"
INVITEE_EMAIL=teammate@example.test
NEW_CUSTOMER_EMAIL=developer.updated@example.test
# Copy the full 43-character code from the worker's development mail log.
VERIFICATION_CODE=
RECOVERY_TOKEN=
EMAIL_CHANGE_CODE=
INVITATION_CODE=
# Current TOTP or unused recovery code; leave customer code empty without MFA.
# A TOTP step/recovery code cannot be reused after a successful authentication.
CUSTOMER_MFA_CODE=
STAFF_MFA_CODE=
