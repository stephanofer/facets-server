# Local development only. Setup generates .env with a random password.
POSTGRES_DB=facets_local
POSTGRES_USER=facets_local
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# db-config creates independent local roles and fills these in the ignored .env.
FACETS_APP_PASSWORD=
FACETS_MIGRATOR_PASSWORD=
FACETS_ENV=development
FACETS_ADDRESS=127.0.0.1:8080
FACETS_DIAGNOSTICS_ADDRESS=127.0.0.1:9090
FACETS_POOL_MAX=8
FACETS_REQUEST_TIMEOUT=10s
FACETS_SQL_TIMEOUT=5s
FACETS_SHUTDOWN_TIMEOUT=15s
FACETS_JOB_TIMEOUT=20s
FACETS_JOB_LEASE=30s
FACETS_WORKERS=2
FACETS_WORKER_QUEUE=notifications
FACETS_QUEUE_LIMIT=10000
FACETS_MAX_BODY=1048576

# db-config generates this independent encryption key in ignored .env.
# Keep the same key across API/workers; back it up separately from PostgreSQL.
FACETS_ACCESS_KEY=
FACETS_DEVELOPMENT_PROFILE=development
FACETS_DEVELOPMENT_MEMBERS=10
FACETS_DEVELOPMENT_VALIDITY=720h
FACETS_MAIL_FROM=

# Notification workers use the native AWS SDK configuration chain and MAIL_FROM.
# API/heavy workers and tests require no live AWS credentials or mail delivery.
# AWS_REGION=us-east-1
# AWS_PROFILE=your-development-profile
